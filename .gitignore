# Out-of-source build directory (see README).
/build/

# Common CMake artifacts if configured in-tree.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Editor / OS cruft.
.DS_Store
*~

# Third-party solver sources are fetched by the user (see third_party/*/README.md),
